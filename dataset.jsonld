{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Cartographie 2026 de la couverture d'artisans RGE par commune vs nombre de logements",
  "@id": "https://legibat.fr/etude-couverture-rge#dataset",
  "description": "Présence locale des entreprises de travaux RGE, rapprochée de la population et du parc de logements. Indicateurs descriptifs avec contrôle des qualifications, sources, données manquantes et limites géographiques documentées. Seuils éditoriaux ; aucune mesure des disponibilités ou des délais d'intervention.",
  "creator": {
    "@type": "Organization",
    "name": "Legibat - Observatoire de la Conformité BTP",
    "url": "https://legibat.fr"
  },
  "license": "https://www.etalab.gouv.fr/licence-ouverte-open-licence/",
  "inLanguage": "fr",
  "isAccessibleForFree": true,
  "dateModified": "2026-10-24",
  "temporalCoverage": "2026-10-24",
  "spatialCoverage": {
    "@type": "Place",
    "name": "France — périmètre communal disponible dans l'API Geo"
  },
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "code_insee",
      "description": "Code commune INSEE, conservant les zéros initiaux et la Corse."
    },
    {
      "@type": "PropertyValue",
      "name": "nom_commune",
      "description": "Nom officiel de commune au jour de collecte API Geo."
    },
    {
      "@type": "PropertyValue",
      "name": "code_departement",
      "description": "Code du département ; DOM sur trois caractères."
    },
    {
      "@type": "PropertyValue",
      "name": "code_region",
      "description": "Code de région INSEE."
    },
    {
      "@type": "PropertyValue",
      "name": "nom_region",
      "description": "Nom de la région dans l'API Geo."
    },
    {
      "@type": "PropertyValue",
      "name": "population",
      "description": "Population fournie par l'API Geo ; millésime non exposé, null si absent."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_logements",
      "description": "Parc INSEE tous logements ; proxy population/taille_ménage si estimation explicite. Null si manquant."
    },
    {
      "@type": "PropertyValue",
      "name": "source_logements",
      "description": "INSEE, estimation_population, manquant ou fictif."
    },
    {
      "@type": "PropertyValue",
      "name": "millesime_logements",
      "description": "Année de référence du recensement INSEE, différente de l'année RGE."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_entreprises_rge",
      "description": "SIREN distincts disposant d'au moins un établissement de travaux RGE actif dans la commune."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_etablissements_rge",
      "description": "SIRET distincts de travaux RGE dont les dates englobent la date d'observation."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_qualif_pv",
      "description": "Nombre de couples établissement-organisme-code-domaine distincts dans la famille pv. Familles non exclusives."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_qualif_pac",
      "description": "Nombre de couples établissement-organisme-code-domaine distincts dans la famille pac. Familles non exclusives."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_qualif_isolation",
      "description": "Nombre de couples établissement-organisme-code-domaine distincts dans la famille isolation. Familles non exclusives."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_qualif_chauffage",
      "description": "Nombre de couples établissement-organisme-code-domaine distincts dans la famille chauffage. Familles non exclusives."
    },
    {
      "@type": "PropertyValue",
      "name": "nb_qualif_menuiserie",
      "description": "Nombre de couples établissement-organisme-code-domaine distincts dans la famille menuiserie. Familles non exclusives."
    },
    {
      "@type": "PropertyValue",
      "name": "ratio_artisans_1000_hab",
      "description": "1000 * entreprises RGE / population ; null si dénominateur nul ou absent."
    },
    {
      "@type": "PropertyValue",
      "name": "ratio_artisans_1000_logements",
      "description": "1000 * entreprises RGE / logements ; null si dénominateur nul ou absent."
    },
    {
      "@type": "PropertyValue",
      "name": "indice_tension_rge",
      "description": "Classe descriptive selon le ratio logements non arrondi. Seuils configurés dans provenance.json ; non officiel."
    },
    {
      "@type": "PropertyValue",
      "name": "url_verification_locale",
      "description": "URL Legibat construite ; existence et disponibilité de cette page non attestées."
    },
    {
      "@type": "PropertyValue",
      "name": "date_observation",
      "description": "Date de contrôle de validité des qualifications (bornes inclusives)."
    },
    {
      "@type": "PropertyValue",
      "name": "donnees_partielles",
      "description": "Vrai pour démonstration ou collecte limitée, dont la publication est interdite."
    }
  ],
  "keywords": [
    "RGE",
    "rénovation énergétique",
    "logement",
    "couverture communale"
  ],
  "isBasedOn": [
    "https://data.ademe.fr/data-fair/api/v1/datasets/liste-des-entreprises-rge-2",
    "https://geo.api.gouv.fr/communes",
    "https://www.insee.fr/fr/statistiques/2521169"
  ],
  "url": "https://legibat.fr/etude-couverture-rge",
  "sameAs": [
    "https://www.data.gouv.fr/datasets/cartographie-2026-de-la-couverture-dartisans-rge-par-commune-vs-nombre-de-logements",
    "https://github.com/Sotani77/open-data-conformite-rge-france",
    "https://sotani77.github.io/open-data-conformite-rge-france/",
    "https://legibat.fr/etude-couverture-rge"
  ],
  "includedInDataCatalog": {
    "@type": "DataCatalog",
    "name": "data.gouv.fr",
    "url": "https://www.data.gouv.fr/"
  },
