# Les valeurs vides désignent des paramètres privés à fournir uniquement pour publier.
# Aucun secret n'est nécessaire pour --dry-run.
DATAGOUV_API_KEY=
DATAGOUV_ORG_ID=
DATAGOUV_DATASET_ID=
ORGANIZATION_SIREN=
ORGANIZATION_SIRET=
ORGANIZATION_LOGO_URL=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=open-data-conformite-rge-france
GITHUB_BRANCH=main
GITHUB_TRANSPORT=api
ENABLE_PAGES=true
DATAGOUV_API_URL=https://www.data.gouv.fr/api/1/
GITHUB_API_VERSION=2026-03-10
HOUSING_MODE=insee
HOUSING_YEAR=2023
HOUSING_GEO_YEAR=2026
INSEE_URL=https://www.insee.fr/fr/statistiques/fichier/2521169/comparateur.parquet
# HOUSING_FILE=work/logements.csv
# AS_OF=2026-10-24
HOUSEHOLD_SIZE=2.2
TENSION_LOW=2.0
TENSION_HIGH=5.0
MAX_UNMATCHED_FRACTION=0.15
MAX_INVALID_FRACTION=0.05
MAX_CONFLICTING_FRACTION=0.001
HTTP_TIMEOUT=60
HTTP_ATTEMPTS=4
PAGE_SIZE=1000
STATE_FILE=.state/publication.json
